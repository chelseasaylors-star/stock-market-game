body {
  font-family: 'Arial', sans-serif;
  margin: 0;
  padding: 0;
  background: #fdf6e3;
  color: #333;
}

header {
  text-align: center;
  padding: 10px;
  background-color: #222;
  color: #fff;
}

h1, h2 {
  margin: 5px;
}

section {
  padding: 10px;
  margin: 5px;
}

#stock-list, #portfolio-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.stock-card, .portfolio-card {
  border: 1px solid #ccc;
  padding: 10px;
  width: 150px;
  border-radius: 5px;
  background-color: #fff;
}

button {
  padding: 5px 10px;
  font-size: 16px;
  margin: 2px;
  cursor: pointer;
}

input {
  padding: 5px;
  font-size: 16px;
}
